# Paideia Genesis Configuration
# Copy this file to .env and fill in your values

# LLM Provider: 'mock' (default, offline), 'gemini', 'openai_compatible'
LLM_PROVIDER=mock

# Google Gemini API (optional, for cloud LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local LLM via Ollama/vLLM/LM Studio (optional)
# No real API key needed for local inference servers
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1:8b

# TypeSafe AI / Jev System 1 (optional)
TYPESAFE_API_KEY=
ENABLE_JEV_SYSTEM_ONE=true

# Server
HOST=0.0.0.0
PORT=8000

# Data directory (defaults to ./data)
# DATA_DIR=./data

# Auto-seed demo curricula on first launch (default: false)
AUTO_SEED_DEMO_DATA=false
